# 第一階段：使用 Node.js 打包 React/Vite 專案
FROM node:18-alpine AS builder
WORKDIR /app

# 💡 關鍵修正：告訴 Docker 去 frontend/ 資料夾拿 package.json
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

# 💡 關鍵修正：只把 frontend/ 裡面的原始碼複製進來打包
COPY frontend/ ./
RUN npm run build

# 第二階段：使用輕量級的 Nginx 伺服器發佈靜態網頁
FROM nginx:alpine
# 將打包好的靜態檔複製到 Nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# 寫入反向代理設定
RUN echo "server { listen 80; location / { root /usr/share/nginx/html; index index.html; try_files \$uri \$uri/ /index.html; } location /api/ { proxy_pass http://backend:8000/api/; } }" > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]